# Read the typed demo fixtures when set to 1; set to 0 only after the Supabase query path is configured.
NEXT_PUBLIC_USE_FIXTURES=1

# Supabase project URL from Project Settings > API. Leave blank when using fixtures.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable key (the dashboard's anon/public key). Leave blank when using fixtures.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# IBM Cloud API key used by the server-side watsonx client. Never commit a real value.
WATSONX_API_KEY=

# watsonx.ai project ID used for model requests. Leave blank in mock mode.
WATSONX_PROJECT_ID=

# watsonx.ai regional base URL, for example https://us-south.ml.cloud.ibm.com.
WATSONX_URL=

# Return deterministic AI fixtures without network calls or credentials.
AI_MOCK=true

# Abort a watsonx request after this many milliseconds.
AI_REQUEST_TIMEOUT_MS=15000
