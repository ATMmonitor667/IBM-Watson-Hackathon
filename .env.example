# Use bundled fixtures so the app runs without a database account.
NEXT_PUBLIC_USE_FIXTURES=1

# Optional: configure Supabase and set NEXT_PUBLIC_USE_FIXTURES=0 for persistence.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# AI_PROVIDER=mock is deterministic, offline, and requires no credentials.
# Set AI_PROVIDER=ollama to use a model running locally through Ollama.
AI_PROVIDER=mock
AI_MODEL=llama3.2:3b
AI_BASE_URL=http://127.0.0.1:11434
AI_REQUEST_TIMEOUT_MS=15000
