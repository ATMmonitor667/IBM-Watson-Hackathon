# Data source.
#   1 (or unset) — read the demo story from src/lib/demo/fixtures.ts
#   0            — read from Supabase (lands at step P5)
# Fixtures are the default so a missing variable can never blank the workspace,
# and they stay wired to the end as the offline fallback for the recording.
NEXT_PUBLIC_USE_FIXTURES=1

# Public Supabase configuration


# AI execution mode.
#   live     — call watsonx for explanations and merge strategies
#   fallback — deterministic rule-engine output only, no network
AI_MODE=live
